# ======== أساسي ========
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_URL=https://example.com
SITE_NAME=EduPro
TIME_ZONE=Africa/Cairo
CORS_ALLOWED_ORIGINS=https://app.example.com

# ======== قاعدة البيانات و Redis ========
DATABASE_URL=postgres://edupro:password@db:5432/edupro
REDIS_URL=redis://redis:6379/0

# ======== JWT ========
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# ======== Jitsi (الحصص اللايف) ========
# مهم: meet.jit.si العام بيقفل الاجتماعات المدمجة بعد 5 دقائق — استخدم سيرفر Jitsi خاص (بـ JWT) أو 8x8 JaaS
JITSI_DOMAIN=meet.example.com
JITSI_APP_ID=edupro
JITSI_APP_SECRET=change-me
JITSI_ROOM_PREFIX=edupro
SESSION_JOIN_EARLY_MINUTES=10

# ======== Paymob ========
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=123456,654321
DEFAULT_CURRENCY=EGP

# ======== Firebase (Push Notifications) ========
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/app/secrets/firebase.json

# ======== SMS / Email ========
SMS_BACKEND=console
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EduPro <no-reply@example.com>

# ======== تطبيق الموبايل ========
APP_MIN_VERSION_ANDROID=1.0.0
APP_MIN_VERSION_IOS=1.0.0
APP_LATEST_VERSION=1.0.0
ANDROID_PACKAGE=com.example.edupro
ANDROID_SHA256_FINGERPRINTS=
IOS_APP_ID=TEAMID.com.example.edupro
PLAY_STORE_URL=
APP_STORE_URL=
SUPPORT_PHONE=
SUPPORT_EMAIL=

# 8x8 JaaS للحصص اللايف في الإنتاج (لو اتظبطوا بيتقدموا على JITSI_*)
JITSI_JAAS_APP_ID=
JITSI_JAAS_KID=
JITSI_JAAS_PRIVATE_KEY_FILE=/app/secrets/jaas_private.pem
# أو حط نص المفتاح نفسه بدل الملف (مفيد على Railway):
# JITSI_JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# فيديوهات الكورسات المرفوعة (محمية)
PRIVATE_MEDIA_ROOT=/app/private_media
PROTECTED_MEDIA_ACCEL=true
VIDEO_MAX_UPLOAD_MB=2048
VIDEO_LINK_TTL_MINUTES=240
TEACHER_CAN_SET_FREE_LESSONS=true

# صور /media/ من غير Nginx (Railway: بيشتغل لوحده)
SERVE_MEDIA=false
MEDIA_ROOT=/app/media
# Firebase: ملف أو محتوى الـ JSON نفسه
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
